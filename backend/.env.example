GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-flash-lite-latest
# WHISPER_MODEL=base
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# DATA_DIR=/absolute/path/for/uploads-and-outputs
# MAX_UPLOAD_MB=500
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash

# --- auth
# JWT_SECRET=           # set in production; if unset a random one is generated into DATA_DIR/.jwt_secret
# TOKEN_TTL_HOURS=336   # how long a sign-in lasts (default 14 days)
# ALLOW_SIGNUP=true     # set false once your own account exists to close registrations

# --- housekeeping
# RETENTION_DAYS=30            # lectures older than this are deleted; 0 = keep forever
# MAX_ACTIVE_JOBS_PER_USER=3
